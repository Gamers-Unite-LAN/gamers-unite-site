# API security
UPLOAD_API_KEY=replace-with-a-long-random-secret

# SQLite
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_IMAGE_SIZE=8388608

# S3 settings
S3_BUCKET=gul-images
S3_REGION=us-east-1

# Public URL used by clients to access uploaded images.
# Example: https://images.example.com/gul-images
S3_PUBLIC_URL_BASE=https://images.example.com/gul-images