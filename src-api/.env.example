# Discord OAuth2
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=https://gamersunitelan.com/api/auth/discord/callback
DISCORD_FRONTEND_URL=https://gamersunitelan.com
DISCORD_ADMIN_USER_IDS=123456789012345678,987654321098765432
SESSION_TTL_MS=604800000

# Native Discord polls (the webhook must have permission to post in its channel).
# Polls are posted one month before each event, warned one week before closing,
# and finalized one week before the event with a generated SVG results image.
DISCORD_POLLS_WEBHOOK_URL=https://discord.com/api/webhooks/replace-id/replace-token

# API limits
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_IMAGE_SIZE=8388608

# S3 settings
S3_BUCKET=gul-images
S3_REGION=us-east-1

# Public URL used by clients to access uploaded images.
# Example: https://images.example.com/gul-images
PUBLIC_ASSET_URL_BASE=https://images.example.com/gul-images

S3_ENDPOINT=https://images.example.com
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret-2
S3_FORCE_PATH_STYLE=true