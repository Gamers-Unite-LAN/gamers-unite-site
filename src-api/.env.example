# API security
UPLOAD_API_KEY=replace-with-a-long-random-secret-1

# SQLite
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_IMAGE_SIZE=8388608

# S3 settings
S3_BUCKET=gul-images
S3_REGION=us-east-1

# Public URL used by clients to access uploaded images.
# Example: https://images.example.com/gul-images
PUBLIC_ASSET_URL_BASE=https://images.example.com/gul-images

S3_ENDPOINT=https://images.example.com
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret-2
S3_FORCE_PATH_STYLE=true